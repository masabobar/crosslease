# Playwright output (HTML report + test artifacts)
src/e2e/reports/

# Playwright MCP browser session artifacts (screenshots, console logs, snapshots)
.playwright-mcp/

# Project management (internal tooling, not for source control)
.project-management/

# Claude config — shared rules/commands/hooks/memory are tracked; local overrides are not
.claude/settings.local.json
# Team memory lives in .claude/memory/ — a stray root-level memory/ is never intentional
/memory/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
