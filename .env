VITE_APP_STAGE=local
PROJECT_NAME=refinext
# Option A: local refinext-api running on localhost:3530 (default) — uncomment this,
# comment out Option B below.
VITE_API_URL=http://localhost:3530/api/v1

# Option B: no local refinext-api — proxy through Vite to a remote API (dev/staging)
# to avoid SameSite=Lax cookie rejection on cross-site requests. Uncomment both lines,
# comment out Option A above.
# VITE_API_URL=/api/v1
# API_PROXY_TARGET=https://api.refinext-dev.projects.holycode.com
