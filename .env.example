VITE_APP_STAGE=local
PROJECT_NAME=refinext
VITE_API_URL=http://localhost:3530/api/v1
# dev server: https://api.refinext-dev.projects.holycode.com/api/v1

# To develop locally against a remote API (dev/staging) instead of a local
# refinext-api, use the Vite dev proxy instead of a direct URL — otherwise
# the auth cookie (SameSite=Lax) is rejected on cross-site requests:
# VITE_API_URL=/api/v1
# API_PROXY_TARGET=https://api.refinext-dev.projects.holycode.com
#
# The production container uses the same two names for the same reason: the
# build takes VITE_API_URL=/api/v1 and nginx proxies /api to API_PROXY_TARGET
# (see nginx.conf.template).

