export PATH="$(dirname $(which node)):$PATH"
corepack pnpm test:run

echo ""
echo "Checking for OpenAPI schema drift..."

OPENAPI_URL="https://api.refinext-dev.projects.holycode.com/api/openapi.json"
TEMP_DIR=$(mktemp -d)

cleanup() {
  rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

# Fails CLOSED. This check used to `exit 0` when the API was unreachable, which meant a
# green push proved nothing — a stale contract sat on develop unnoticed because one machine's
# fetch happened to fail. If you are genuinely offline, skip it deliberately:
#   SKIP_OPENAPI_DRIFT_CHECK=1 git push
# and re-run `pnpm fetch:openapi` before opening the MR.
if [ "$SKIP_OPENAPI_DRIFT_CHECK" = "1" ]; then
  echo "⚠️  SKIP_OPENAPI_DRIFT_CHECK=1 — drift check deliberately skipped."
  echo "   The contract is UNVERIFIED for this push. Re-run pnpm fetch:openapi before the MR."
  exit 0
fi

if ! curl -sf --connect-timeout 10 --retry 2 "$OPENAPI_URL" -o "$TEMP_DIR/openapi.json" 2>/dev/null; then
  echo "❌ Could not reach the dev API, so schema drift could NOT be checked."
  echo "   Not skipping: an unverified contract is how drift reaches develop unnoticed."
  echo "   If you are offline and accept that risk, push with:"
  echo "     SKIP_OPENAPI_DRIFT_CHECK=1 git push"
  exit 1
fi

corepack pnpm exec prettier --write "$TEMP_DIR/openapi.json" 2>/dev/null
corepack pnpm exec openapi-zod-client "$TEMP_DIR/openapi.json" -o "$TEMP_DIR/api.ts" 2>/dev/null
# Same repair `generate:api` applies, so both sides of the diff below are produced by an
# identical pipeline. Without it the generator's Zod v3 `z.record()` output is compared against
# a committed file carrying the v4 fix, and the check reports drift on every push regardless of
# whether the backend moved at all.
node scripts/fix-generated-zod-record.js "$TEMP_DIR/api.ts" >/dev/null

DRIFT=0
diff -q openapi.json "$TEMP_DIR/openapi.json" >/dev/null 2>&1 || DRIFT=1
diff -q src/generated/api.ts "$TEMP_DIR/api.ts" >/dev/null 2>&1 || DRIFT=1

if [ "$DRIFT" -eq 1 ]; then
  echo "❌ OpenAPI schema drift detected — the backend contract has changed."
  echo "   Run: pnpm fetch:openapi        (now formats openapi.json for you)"
  echo "   Then: git add openapi.json src/generated/api.ts && git commit"
  exit 1
fi

echo "✅ OpenAPI schema in sync."
